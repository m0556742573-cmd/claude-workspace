# Claude Code local settings (machine-specific, not shared)
.claude/settings.local.json

# Secrets - never commit
.env
.env.*
!.env.example

# Access/credentials registry (metadata about secrets - local only, per project)
**/docs/access.md

# OS junk
.DS_Store
Thumbs.db

# Node (in case tooling gets added later)
node_modules/

# Runtime log of the daily backup - local, changes on every run.
# Tracked, it would make the doc checker fail forever and teach you to ignore it.
כלים/backup.log

# Generated from the book HTML on demand. Rule 2: what is derived is
# not stored - and a 1MB binary that changes wholesale on every render
# makes every diff useless.
*.pdf
מתודולוגיה/ספר/ספר.html
מתודולוגיה/ספר/print.tmp.html
